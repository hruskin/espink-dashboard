# Nastavení lokálního serveru (add-on ESPink Server v Home Assistantu).
# Po změně spusť znovu ./prepare.sh a firmware znovu sestav a nahraj.

# IP adresa Home Assistantu (raději IP než homeassistant.local – mDNS při
# probuzení z deep sleepu zdržuje a nemusí fungovat)
ZO_HOST=192.168.0.73

# Port add-onu (config.yaml add-onu: ports 8099/tcp)
ZO_PORT=8099
